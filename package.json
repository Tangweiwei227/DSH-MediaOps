{
  "name": "dsh-mediaops",
  "version": "0.2.0",
  "description": "AI-native media operations plugin for DeepSeek Harness: multimodal model control, @ references, trend discovery, content libraries and confirmed publishing, with 112 bundled Easel skills.",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-input-trigger",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint:frontmatter": "node scripts/lint-frontmatter.mjs",
    "lint:website": "node scripts/check-website.mjs",
    "check:upstream:snapshot": "node scripts/check-easel-drift.mjs --offline",
    "update:upstream:curated": "node scripts/check-easel-drift.mjs --update-curated-digest",
    "check:upstream": "node scripts/check-easel-drift.mjs",
    "report:upstream": "node scripts/sync-skills.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack:dry-run": "npm pack --dry-run --cache ./.npm-cache",
    "check": "pnpm lint:frontmatter && pnpm lint:website && pnpm check:upstream:snapshot && pnpm typecheck && pnpm test && pnpm build && pnpm pack:dry-run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-input-trigger": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-host-webserver": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-skill": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-system-prompt": "^0.2.2-rc.3",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.3",
    "@deepseek-ai/schemastery": "^3.18.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-input-trigger": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-llm": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-skill": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.2",
    "@deepseek-ai/dsh-tools": "^0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.5",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.7.2",
    "vitest": "^3.2.4"
  },
  "files": [
    "lib",
    "src",
    "skills",
    "docs",
    "upstream",
    "cordis.patch.yml",
    "README.md",
    "SECURITY.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "third_party_licenses",
    "!skills/**/tests/**",
    "!skills/**/.github/**",
    "!skills/**/credentials/**",
    "!skills/**/browser-profiles/**",
    "!skills/**/.dsh-browser-profiles/**",
    "!skills/**/.easel-browser-profiles/**",
    "!skills/**/outputs/**",
    "!skills/**/profiles/**",
    "!skills/**/cookies*.json",
    "!skills/**/*token_cache*.json"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "media-ops",
    "content-operations",
    "social-media",
    "multimodal",
    "easel",
    "ai-native"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tangweiwei227/DSH-MediaOps.git"
  },
  "bugs": {
    "url": "https://github.com/Tangweiwei227/DSH-MediaOps/issues"
  },
  "homepage": "https://dsh-mediaops.tevin2501689480.chatgpt.site"
}
